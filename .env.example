# Copy this file to .env.local (gitignored) and fill in your own values.
# URL printed by `gcloud run deploy` for the server/ service.
VITE_AUTOCUT_SERVER_URL=https://autocut-server-xxxxx.asia-southeast1.run.app
# Must match the API_KEY env var the server was deployed with.
VITE_AUTOCUT_SERVER_API_KEY=
